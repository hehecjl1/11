---
interface Props {
  title: string;
  description: string;
  href: string;
  date: Date;
  tags?: string[];
}

const { title, description, href, date, tags = [] } = Astro.props;
const formatted = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  <time datetime={date.toISOString()}>{formatted}</time>
  <h2><a href={href}>{title}</a></h2>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  time {
    font-size: 0.85rem;
    color: var(--muted);
  }

  h2 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.2rem;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
  }
</style>
